{
  "cleaning": {
    "global_mean_imputation": false,
    "maximum_cigarettes_per_day": 80.0,
    "maximum_standard_pack_years": 120.0,
    "retained_histories": 167,
    "retained_histories_by_sex_status": {
      "female/current": 34,
      "female/former": 38,
      "male/current": 32,
      "male/former": 63
    },
    "robust_outlier_limit": 4.5
  },
  "conditional_history_assignment": {
    "current_years_since_quitting": 0,
    "matching_keys": [
      "attained_age",
      "sex",
      "smoking_status"
    ],
    "method": "sample one complete synthetic predictive row",
    "never_smoker_history": "structural_zero",
    "respondent_rows_exported": false,
    "source": "plco_smoking_history_synthetic_pool.csv"
  },
  "constraints": [
    "5 <= age_at_initiation < attained_age",
    "current: age_at_stopping is missing and years_since_quitting = 0",
    "former: age_at_initiation < age_at_stopping <= attained_age",
    "0 < cigarettes_per_day <= 80",
    "standard_pack_years <= 120",
    "adjusted_pack_years <= 60"
  ],
  "joint_generation": {
    "donor_sources": {
      "female/current": {
        "n_complete_vectors": 34,
        "source": "same_sex_status"
      },
      "female/former": {
        "n_complete_vectors": 38,
        "source": "same_sex_status"
      },
      "male/current": {
        "n_complete_vectors": 32,
        "source": "same_sex_status"
      },
      "male/former": {
        "n_complete_vectors": 63,
        "source": "same_sex_status"
      }
    },
    "fallback": "same smoking status pooled across sex when fewer than 10 vectors are available",
    "method": "resample complete standardised residual vectors"
  },
  "model_family": "non_bayesian_robust_penalised_spline_location_scale",
  "model_version": "smooth_history_v1",
  "population_age_range": {
    "inclusive": true,
    "maximum": 79,
    "minimum": 50
  },
  "population_year": 2022,
  "smoking_statuses": [
    "current",
    "former",
    "never"
  ],
  "source_roles": {
    "age_sex_population": "Irish Census-based population inputs",
    "conditional_smoking_histories": "Eurobarometer 2017",
    "smoking_status_prevalence": "Irish Census processed outputs"
  },
  "status_assignment": {
    "matching_keys": [
      "five_year_age_group",
      "sex"
    ],
    "method": "sample current, former, or never using assignment_probability",
    "not_stated_handling": "renormalise current, former, and never",
    "source": "irish_smoking_status_age_sex_2022.csv"
  },
  "synthetic_pool": {
    "draws_per_exact_age_sex_status_cell": 250,
    "expected_rows": 30000,
    "random_seed": 20260731
  }
}
